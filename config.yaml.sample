# Deployment configuration template for deploy.sh
#
# Copy this file to config.yaml, edit the values (at minimum: account and region), then run:
#     cp config.yaml.sample config.yaml
#     ./deploy.sh
#
# Format: simple "key: value" lines. Quotes are optional. Lines starting with # are ignored.
# config.yaml is git-ignored so account-specific values stay out of the repository.

# --- Required -----------------------------------------------------------------------

# Twelve-digit AWS account ID to deploy into.
# Find it:  aws sts get-caller-identity --query Account --output text
account: "<account-number>"

# AWS region for the stack, e.g. us-west-2 or us-east-1. Must match where your credentials are configured to operate.
region: <region>

# --- Optional -----------------------------------------------------------------------

# Deployment stage. Use "dev" for evaluation. Dashboards access below is only allowed in dev.
environment: dev

# Named AWS CLI profile to use. Leave blank to use the default credential chain
# (environment variables, SSO session, instance role).
profile:

# Enable browser access to OpenSearch Dashboards (development only).
# The Dashboards endpoint becomes reachable from the public internet but still requires
# IAM authentication as the role below; the collection API stays private.
enable_public_dashboard: true

# IAM ROLE ARN that will open Dashboards. Leave blank to auto-detect the role behind the
# current credentials (the recommended setting when the deployer is also the Dashboards user).
# Must be a role (not a user) in the same account. Example for an SSO role:
#   arn:aws:iam::<account-number>:role/aws-reserved/sso.amazonaws.com/us-east-1/AWSReservedSSO_AdministratorAccess_0123456789abcdef
dashboard_principal_arn:


# Run the full validation gate (lint, types, tests, synth) before deploying.
validate: true

# Stack/resource name prefix. Only change this if you deploy more than one copy per account.
project_name: manifest-medex-data-quality

# --- Optional: deploy into an existing VPC -------------------------------------------
# Leave all four blank to let the stack create its own isolated VPC (default).
# To use your own VPC, supply all four. Requirements for the subnets:
#   - private: no route to an internet gateway (a NAT route is tolerated but unnecessary)
#   - at least two subnets in two different Availability Zones (Aurora requires this);
#     three (one per AZ) is typical, e.g. subnet_ids: subnet-aaa,subnet-bbb,subnet-ccc
#   - free IP space for ~6 endpoint ENIs per subnet plus Lambda ENIs (/24 or larger)
#   - VPC endpoints: deploy.sh detects any existing S3, DynamoDB, RDS Data API, SQS, or
#     Lambda endpoints in the VPC and reuses them; missing ones are created by the stack
# Lists are comma-separated, in matching order (subnet N uses route table N in AZ N).
# Find route tables:  aws ec2 describe-route-tables --filters Name=association.subnet-id,Values=<subnet-id> --query "RouteTables[0].RouteTableId"
vpc_id:
subnet_ids:
route_table_ids:
availability_zones:

# Normally left blank: deploy.sh fills this in automatically from the VPC. Set it only to
# override detection. Gateway services are bare names; interface services need the
# endpoint id and its security group id, e.g.
#   existing_endpoints: s3,dynamodb,sqs=vpce-0123456789abcdef0:sg-0123456789abcdef0
existing_endpoints:
