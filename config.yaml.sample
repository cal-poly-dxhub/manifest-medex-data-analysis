# Deployment configuration template for deploy.sh
#
# Copy this file to config.yaml, edit the values (at minimum: account and region), then run:
#     cp config.yaml.sample config.yaml
#     ./deploy.sh
#
# Format: simple "key: value" lines. Quotes are optional. Lines starting with # are ignored.
# config.yaml is git-ignored so account-specific values stay out of the repository.

# --- Required -----------------------------------------------------------------------

# Twelve-digit AWS account ID to deploy into.
# Find it:  aws sts get-caller-identity --query Account --output text
account: "<account-number>"

# AWS region for the stack, e.g. us-west-2 or us-east-1. Must match where your credentials are configured to operate.
region: <region>

# --- Optional -----------------------------------------------------------------------

# Deployment stage. Use "dev" for evaluation. Dashboards access below is only allowed in dev.
environment: dev

# Named AWS CLI profile to use. Leave blank to use the default credential chain
# (environment variables, SSO session, instance role).
profile:

# Enable browser access to OpenSearch Dashboards (development only).
# The Dashboards endpoint becomes reachable from the public internet but still requires
# IAM authentication as the role below; the collection API stays private.
enable_public_dashboard: true

# IAM ROLE ARN that will open Dashboards. Leave blank to auto-detect the role behind the
# current credentials (the recommended setting when the deployer is also the Dashboards user).
# Must be a role (not a user) in the same account. Example for an SSO role:
#   arn:aws:iam::<account-number>:role/aws-reserved/sso.amazonaws.com/us-east-1/AWSReservedSSO_AdministratorAccess_0123456789abcdef
dashboard_principal_arn:


# Run the full validation gate (lint, types, tests, synth) before deploying.
validate: true

# Stack/resource name prefix. Only change this if you deploy more than one copy per account.
project_name: manifest-medex-data-quality

# --- Optional: deploy into an existing VPC -------------------------------------------
# Leave all four blank to let the stack create its own isolated VPC (default).
# To use your own VPC, supply all four. Requirements for the subnets:
#   - private: no route to an internet gateway (a NAT route is tolerated but unnecessary)
#   - at least two subnets in two different Availability Zones (Aurora requires this);
#     three (one per AZ) is typical, e.g. subnet_ids: subnet-aaa,subnet-bbb,subnet-ccc
#   - free IP space for ~9 endpoint ENIs per subnet plus one per ECS task and Lambda
#     (/24 or larger)
#   - VPC endpoints: deploy.sh detects any existing S3, DynamoDB, RDS Data API, SQS,
#     Lambda, ECR (ecr.api, ecr.dkr), or CloudWatch Logs endpoints in the VPC and reuses
#     them; missing ones are created by the stack. A reused SQS endpoint with a
#     restrictive policy must allow the worker roles (see DEPLOYMENT.md)
# Lists are comma-separated, in matching order (subnet N uses route table N in AZ N).
# Find route tables:  aws ec2 describe-route-tables --filters Name=association.subnet-id,Values=<subnet-id> --query "RouteTables[0].RouteTableId"
vpc_id:
subnet_ids:
route_table_ids:
availability_zones:

# Normally left blank: deploy.sh fills this in automatically from the VPC. Set it only to
# override detection. Gateway services are bare names; interface services need the
# endpoint id and its security group id, e.g.
#   existing_endpoints: s3,dynamodb,sqs=vpce-0123456789abcdef0:sg-0123456789abcdef0
existing_endpoints:

# --- Optional: ingestion workers (ECS on Fargate) -----------------------------------
# Production-sized defaults apply in every environment; leave blank to use them.
# See README "Ingestion workers" for how they were measured.
# Task size: cpu 1024 allows memory 2048-8192; cpu 2048 allows 4096-16384.
hl7_task_cpu:              # default 1024
hl7_task_memory:           # default 2048
hl7_workers:               # worker processes per task, default 8
hl7_receive_batch_size:    # messages per receive (1-10), default 10
hl7_min_tasks:             # default 2
hl7_max_tasks:             # default 10
hl7_backlog_target:        # visible messages per task to scale toward, default 1000
hl7_max_object_mb:         # largest HL7 file in MiB, default 512 (streamed in 500-message chunks)

ccda_task_cpu:             # default 1024
ccda_task_memory:          # default 8192 (fits four ~100 MB CCDAs in flight)
ccda_workers:              # default 4
ccda_receive_batch_size:   # default 1
ccda_min_tasks:            # default 2
ccda_max_tasks:            # default 10
ccda_backlog_target:       # default 200
ccda_max_object_mb:        # largest CCDA file in MiB, default 110

# Scheduled work-hours scaling (off by default). When set, both services keep at least
# this many tasks on weekdays 07:45-17:30 in work_hours_timezone. Must lie within each
# lane's min/max.
work_hours_min_tasks:
work_hours_timezone:       # IANA name, default America/Los_Angeles

# --- Optional: Aurora Serverless v2 capacity ----------------------------------------
# Start at 16, load test, review after 1-3 months, then set max to ~2x observed peak.
# Values are multiples of 0.5. Raising max later is an in-place change.
aurora_min_acu:            # default 2
aurora_max_acu:            # default 16

# --- Optional: Prism-compatible message intake API (off by default) ------------------
# Lets an integration engine (e.g. Rhapsody) keep posting Prism's Clinical Message Intake
# JSON. Runs behind an INTERNAL HTTPS load balancer (never internet-facing). See
# DEPLOYMENT.md "Optional: message intake API" before enabling.
enable_intake: false
intake_sender_id: sender            # lowercase name of the one sender, e.g. rhapsody
intake_source_cidrs:                # sender networks, private IPv4 /16 or narrower, comma-separated
intake_certificate_arn:             # ACM certificate for the intake hostname (required when enabled)
intake_max_request_mb:              # largest accepted request, default 150 (a ~110 MiB CCDA after base64)
intake_task_cpu:                    # default 1024
intake_task_memory:                 # default 4096
intake_min_tasks:                   # default 2
intake_max_tasks:                   # default 4
intake_archive_retention_days:      # days to keep archived request bodies, default 90
