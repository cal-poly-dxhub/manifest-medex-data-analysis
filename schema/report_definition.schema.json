{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://manifestmedex.example/schema/report_definition.schema.json",
  "title": "Report Definition",
  "description": "Structure of a Reports backend definition, derived from seed/p4p-prototype.json. Cross-item invariants (unique seq values, reserved query fields) are enforced by src/report_definition.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_id",
    "name",
    "description",
    "partition_field",
    "time_field",
    "sections"
  ],
  "properties": {
    "report_id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "partition_field": {
      "const": "sourceFacilityId"
    },
    "time_field": {
      "const": "messageTime"
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/section"
      }
    }
  },
  "$defs": {
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seq",
        "name",
        "rows"
      ],
      "properties": {
        "seq": {
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/row"
          }
        }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seq",
        "label",
        "description",
        "index",
        "query"
      ],
      "properties": {
        "seq": {
          "type": "integer",
          "minimum": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "index": {
          "enum": [
            "hl7-messages-v1",
            "ccda-documents-v1"
          ]
        },
        "query": {
          "anyOf": [
            {
              "type": "object",
              "minProperties": 1
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
